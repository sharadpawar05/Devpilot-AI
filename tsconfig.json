{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@devpilot/ai-core": ["./packages/ai-core/src"],
      "@devpilot/ai-providers": ["./packages/ai-providers/src"],
      "@devpilot/ai-prompts": ["./packages/ai-prompts/src"],
      "@devpilot/ui": ["./packages/ui/src"],
      "@devpilot/config": ["./packages/config/src"],
      "@devpilot/shared": ["./packages/shared/src"],
      "@devpilot/types": ["./packages/types/src"],
      "@devpilot/utils": ["./packages/utils/src"]
    }
  },
  "files": []
}
