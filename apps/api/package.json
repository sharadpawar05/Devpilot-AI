{
  "name": "@devpilot/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "prisma generate",
    "start": "tsx src/server.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force && pnpm db:seed"
  },
  "dependencies": {
    "@devpilot/ai-core": "workspace:*",
    "@devpilot/ai-prompts": "workspace:*",
    "@devpilot/ai-providers": "workspace:*",
    "@devpilot/config": "workspace:*",
    "@devpilot/shared": "workspace:*",
    "@devpilot/types": "workspace:*",
    "@fastify/cookie": "9.4.0",
    "@fastify/cors": "^9.0.0",
    "@fastify/helmet": "^11.0.0",
    "@fastify/rate-limit": "^9.0.0",
    "@fastify/swagger": "^8.12.0",
    "@fastify/swagger-ui": "^4.0.0",
    "@prisma/client": "^6.12.0",
    "fastify": "^4.26.0",
    "tsx": "^4.7.0",
    "jose": "^6.2.5",
    "octokit": "^5.0.5",
    "zod": "^3.22.0",
    "prisma": "^6.12.0",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "pino-pretty": "^13.1.3",
    "typescript": "^5.4.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
