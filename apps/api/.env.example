# Server
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
API_PREFIX=/api/v1
LOG_LEVEL=info
# Comma-separated allowlist. Never use * in production (breaks credentials).
CORS_ORIGIN=http://localhost:3000,https://devpilot-ai-phi.vercel.app

# Supabase
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Service-role key (server-only). Needed for avatar storage + account deletion.
# Never expose to the client. Find it in Supabase Dashboard → Settings → API.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Database
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-1-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres"

# GitHub OAuth
GITHUB_CLIENT_ID=YOUR_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=YOUR_GITHUB_CLIENT_SECRET
GITHUB_REDIRECT_URI=https://devpilot-ai-phi.vercel.app/github

# Encryption (generate strong random values: openssl rand -base64 32)
ENCRYPTION_SECRET=
COOKIE_SECRET=

# AI Provider
# Groq (OpenAI-compatible). Env may use GROAK_API_KEY or GROQ_API_KEY
GROAK_API_KEY=
GEMINI_API_KEY=
AI_DEFAULT_MODEL=gemini-3.6-flash
